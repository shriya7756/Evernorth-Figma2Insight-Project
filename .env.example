# Figma2Insight API configuration
# Copy this file to `.env` in the project root and fill in your values.
# `.env` is git-ignored; never commit real credentials.

# --- MongoDB (saved analyses) ---------------------------------------------
# Connection string for your MongoDB deployment. When this is empty, saved
# analyses fall back to local JSON files under outputs/history/.
#   Local:  mongodb://localhost:27017
#   Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=

# Database name used by Figma2Insight.
MONGODB_DB_NAME=figma2insight

# How long (ms) to wait when selecting a MongoDB server before failing a request.
MONGODB_TIMEOUT_MS=5000

# --- API server -----------------------------------------------------------
# Port for `python server.py` (the Vite dev server proxies /api to 8001).
PORT=8001
# Interface to bind. Keep 127.0.0.1 unless you deliberately expose the API.
HOST=127.0.0.1

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Maximum accepted size of an uploaded Figma JSON file, in megabytes.
MAX_UPLOAD_MB=50
